    font-size: 0.7rem;
    font-weight: 600;
    color: var(--gray-500);
    letter-spacing: 1px;
}

.system-value {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--green-primary);
    letter-spacing: 0.5px;
}

.system-value.alarm-off {
    color: var(--gray-500);
}

.system-value.alarm-active {
    color: var(--danger-color);
}

.system-value.valve-closed {
    color: var(--danger-color);
}

.system-value.wifi-connected {
    color: var(--blue-color);
}

.system-value.wifi-disconnected {
    color: var(--gray-500);
}

/* History Card */
.card-history {
    padding: 20px;
}

.history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.history-header .card-title {
    margin-bottom: 0;
}

.btn-view-all {
    background: none;
    border: none;
    color: var(--green-primary);
    font-family: 'Poppins', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: var(--transition);
}

.btn-view-all:hover {
    background: var(--green-light);
}

.history-table-wrapper {
    overflow-x: auto;
}

.history-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
}

.history-table thead th {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gray-500);
    text-align: left;
    padding: 6px 12px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-bottom: 2px solid var(--gray-200);
}

.history-table tbody tr {
    background: var(--gray-50);
    border-radius: var(--radius-sm);
    transition: var(--transition);
    animation: slideInRow 0.4s ease-out;
}

.history-table tbody tr:hover {
    background: var(--gray-200);
    transform: scale(1.01);
}

.history-table tbody td {
    padding: 10px 12px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--gray-700);
}

.history-table tbody tr td:first-child {
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
}

.history-table tbody tr td:last-child {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.status-badge {
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    display: inline-block;
}

.status-badge.badge-aman {
    background: var(--green-light);
    color: var(--green-primary);
}

.status-badge.badge-warning {
    background: var(--warning-bg);
    color: var(--warning-color);
}

.status-badge.badge-bahaya {
    background: var(--danger-bg);
    color: var(--danger-color);
}

/* Footer */
.dashboard-footer {
    text-align: center;
    padding: 16px;
    font-size: 0.72rem;
    color: var(--gray-500);
    background: var(--white);
    border-top: 1px solid var(--gray-200);
}

/* ===== MODAL ===== */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    animation: fadeIn 0.3s ease;
    padding: 20px;
}

.modal-content {
    background: var(--white);
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 600px;
    max-height: 80vh;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    animation: fadeInUp 0.4s ease-out;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
    color: var(--white);
}

.modal-header h2 {
    font-size: 1.1rem;
    font-weight: 700;
}

.modal-close {
    background: rgba(255,255,255,0.2);
    border: none;
    color: var(--white);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

.modal-close:hover {
    background: rgba(255,255,255,0.35);
    transform: rotate(90deg);
}

.modal-body {
    padding: 20px 24px;
    max-height: 60vh;
    overflow-y: auto;
}

.modal-table {
    border-spacing: 0 4px;
}

/* ===== RESPONSIVE ===== */

/* Tablet */
@media (max-width: 768px) {
    .dashboard-header {
        padding: 14px 18px;
    }

    .header-title {
        font-size: 1.3rem;
    }

    .dashboard-content {
        padding: 16px;
        gap: 14px;
    }

    .cards-row-top {
        grid-template-columns: 1fr 1fr;
    }

    .system-indicators {
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }
}

/* Mobile */
@media (max-width: 480px) {
    .login-container {
        padding: 30px 20px;
    }

    .logo-shield {
        width: 56px;
        height: 64px;
    }

    .logo-title {
        font-size: 2.4rem;
    }

    .logo-subtitle {
        font-size: 0.6rem;
    }

    .tagline {
        font-size: 0.85rem;
    }

    .stove-image-wrapper {
        width: 180px;
        height: 150px;
    }

    .dashboard-header {
        padding: 12px 16px;
    }

    .header-title {
        font-size: 1.2rem;
    }

    .header-time-badge {
        padding: 4px 10px;
        font-size: 0.72rem;
    }

    .dashboard-content {
        padding: 12px;
        gap: 12px;
    }

    .cards-row-top {
        grid-template-columns: 1fr;
    }

    .card {
        padding: 16px;
    }

    .gas-status-text {
        font-size: 1.3rem;
    }

    .temp-value {
        font-size: 1.8rem;
    }

    .system-indicators {
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }

    .system-icon-wrapper {
        width: 36px;
        height: 36px;
    }

    .system-label {
        font-size: 0.62rem;
    }

    .system-value {
        font-size: 0.64rem;
    }

    .history-table thead th {
        font-size: 0.68rem;
        padding: 4px 8px;
    }

    .history-table tbody td {
        padding: 8px;
        font-size: 0.75rem;
    }

    .btn-connect {
        padding: 14px;
        font-size: 1rem;
    }
}

/* Large Desktop */
@media (min-width: 901px) {
    .dashboard-content {
        padding: 24px 30px;
    }

    .cards-row-top {
        grid-template-columns: 1fr 1fr;
    }
}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar {
    width: 6px;
}

::-webkit-scrollbar-track {
    background: var(--gray-100);
}

::-webkit-scrollbar-thumb {
    background: var(--gray-400);
    border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--gray-500);
}

/* ===== FOCUS STYLES ===== */
:focus-visible {
    outline: 3px solid var(--green-primary);
    outline-offset: 2px;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="SP3S - Smart Portable Stove Safety System Monitoring Dashboard. Monitor gas status, temperature, valve, and alarm in real-time.">
    <title>SP3S - Smart Portable Stove Safety System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- ============ LOGIN PAGE ============ -->
    <div id="loginPage" class="page login-page">
        <div class="login-container">
            <!-- Logo Section -->
            <div class="login-logo-section">
                <div class="logo-icon-wrapper">
                    <svg class="logo-shield" viewBox="0 0 80 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M40 2L6 18V42C6 64 20 82 40 88C60 82 74 64 74 42V18L40 2Z" fill="#0B8A1E" stroke="#0B8A1E" stroke-width="2"/>
                        <path d="M40 20C40 20 30 30 30 42C30 50 34 56 40 60C46 56 50 50 50 42C50 30 40 20 40 20Z" fill="#FF6B00" opacity="0.9"/>
                        <path d="M40 28C40 28 35 35 35 43C35 48 37 52 40 54C43 52 45 48 45 43C45 35 40 28 40 28Z" fill="#FFD600" opacity="0.9"/>
                    </svg>
                </div>
                <div class="logo-text-group">
                    <h1 class="logo-title">SP3S</h1>
                    <p class="logo-subtitle">SMART PORTABLE STOVE<br>SAFETY SYSTEM</p>
                </div>
            </div>

            <!-- Tagline -->
            <p class="tagline">"Smart Detection, Smart Protection"</p>

            <!-- Stove Image -->
            <div class="stove-image-wrapper">
                <svg class="stove-image" viewBox="0 0 280 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Stove Body -->
                    <rect x="30" y="80" width="220" height="110" rx="12" fill="#2D2D2D" stroke="#1a1a1a" stroke-width="2"/>
                    <rect x="35" y="85" width="210" height="100" rx="10" fill="#3a3a3a"/>
                    <!-- Top Panel -->
                    <rect x="30" y="70" width="220" height="20" rx="6" fill="#404040" stroke="#333" stroke-width="1"/>
                    <!-- Burner Ring Outer -->
                    <circle cx="140" cy="130" r="45" fill="#4a4a4a" stroke="#555" stroke-width="2"/>
                    <circle cx="140" cy="130" r="38" fill="#3d3d3d" stroke="#555" stroke-width="1"/>
                    <!-- Burner Grate -->
                    <line x1="110" y1="130" x2="170" y2="130" stroke="#666" stroke-width="3" stroke-linecap="round"/>
                    <line x1="140" y1="100" x2="140" y2="160" stroke="#666" stroke-width="3" stroke-linecap="round"/>
                    <line x1="118" y1="108" x2="162" y2="152" stroke="#666" stroke-width="3" stroke-linecap="round"/>
                    <line x1="162" y1="108" x2="118" y2="152" stroke="#666" stroke-width="3" stroke-linecap="round"/>
                    <!-- Center Burner -->
                    <circle cx="140" cy="130" r="12" fill="#555" stroke="#666" stroke-width="1"/>
                    <circle cx="140" cy="130" r="6" fill="#444"/>
                    <!-- Blue Flame -->
                    <path d="M132 125C132 125 136 115 140 112C144 115 148 125 148 125" fill="#1E88E5" opacity="0.7"/>
                    <path d="M135 127C135 127 138 119 140 117C142 119 145 127 145 127" fill="#42A5F5" opacity="0.8"/>
                    <path d="M137 128C137 128 139 122 140 120C141 122 143 128 143 128" fill="#64B5F6" opacity="0.9"/>
                    <!-- Drip Tray -->
                    <rect x="50" y="175" width="180" height="8" rx="3" fill="#C0C0C0" stroke="#999" stroke-width="1"/>
                    <!-- Knob -->
                    <circle cx="240" cy="135" r="12" fill="#E53935" stroke="#C62828" stroke-width="2"/>
                    <circle cx="240" cy="135" r="4" fill="#C62828"/>
                    <line x1="240" y1="127" x2="240" y2="131" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                    <!-- Gas Canister Slot -->
                    <rect x="30" y="155" width="60" height="25" rx="4" fill="#353535" stroke="#444" stroke-width="1"/>
                    <rect x="35" y="160" width="50" height="15" rx="3" fill="#2a2a2a"/>
                    <!-- SP3S Label -->
                    <rect x="100" y="165" width="50" height="16" rx="4" fill="#0B8A1E"/>
                    <text x="125" y="177" text-anchor="middle" fill="white" font-family="Poppins, sans-serif" font-size="9" font-weight="700">SP3S</text>
                    <!-- Feet -->
                    <rect x="50" y="185" width="20" height="6" rx="3" fill="#999"/>
                    <rect x="210" y="185" width="20" height="6" rx="3" fill="#999"/>
                </svg>
            </div>

            <!-- IP Input -->
            <div class="login-form">
                <div class="input-wrapper">
                    <input type="text" id="ipInput" placeholder="Masukkan Alamat IP" autocomplete="off" spellcheck="false">
                </div>
                <p id="errorMessage" class="error-message"></p>
                <button id="connectBtn" class="btn-connect" onclick="connectToDevice()">
                    SAMBUNGKAN
                </button>
            </div>
        </div>
    </div>

    <!-- ============ DASHBOARD PAGE ============ -->
    <div id="dashboardPage" class="page dashboard-page" style="display:none;">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="header-left">
                <div class="header-logo-icon">
                    <svg viewBox="0 0 40 45" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 1L3 9V21C3 32 10 41 20 44C30 41 37 32 37 21V9L20 1Z" fill="white" fill-opacity="0.2" stroke="white" stroke-width="1.5"/>
                        <path d="M20 10C20 10 15 15 15 21C15 25 17 28 20 30C23 28 25 25 25 21C25 15 20 10 20 10Z" fill="#FF6B00" opacity="0.9"/>
                        <path d="M20 14C20 14 17.5 17.5 17.5 21.5C17.5 24 18.5 26 20 27C21.5 26 22.5 24 22.5 21.5C22.5 17.5 20 14 20 14Z" fill="#FFD600" opacity="0.9"/>
                    </svg>
                </div>
                <span class="header-title">SP3S</span>
            </div>
            <div class="header-right">
                <div class="header-status-info">
                    <span class="header-status-label">Terhubung</span>
                    <span class="header-ip" id="headerIP">192.168.1.1</span>
                </div>
                <div class="header-time-badge" id="headerTime">10.55</div>
                <button class="btn-disconnect" id="btnDisconnect" title="Ganti IP / Putuskan Koneksi">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18.36 6.64A9 9 0 1 1 5.64 6.64" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="12" y1="2" x2="12" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="dashboard-content">
            <!-- Status Cards Row -->
            <div class="cards-row-top">
                <!-- Gas Status Card -->
                <div class="card card-gas" id="cardGas">
                    <h2 class="card-title">Status Gas</h2>
                    <div class="card-gas-content">
                        <div class="gas-icon-wrapper" id="gasIconWrapper">
                            <svg id="gasIconSafe" class="gas-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="32" cy="32" r="30" fill="#0B8A1E" fill-opacity="0.1" stroke="#0B8A1E" stroke-width="2.5"/>
                                <path d="M20 33L28 41L44 25" stroke="#0B8A1E" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <svg id="gasIconWarning" class="gas-icon" viewBox="0 0 64 64" fill="none" style="display:none;" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="32" cy="32" r="30" fill="#E8A817" fill-opacity="0.1" stroke="#E8A817" stroke-width="2.5"/>
                                <path d="M32 18V38" stroke="#E8A817" stroke-width="4" stroke-linecap="round"/>
                                <circle cx="32" cy="46" r="3" fill="#E8A817"/>
                            </svg>
                            <svg id="gasIconDanger" class="gas-icon" viewBox="0 0 64 64" fill="none" style="display:none;" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="32" cy="32" r="30" fill="#DC2626" fill-opacity="0.1" stroke="#DC2626" stroke-width="2.5"/>
                                <path d="M22 22L42 42M42 22L22 42" stroke="#DC2626" stroke-width="4" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <span class="gas-status-text" id="gasStatusText">AMAN</span>
                    </div>
                </div>

                <!-- Temperature Card -->
                <div class="card card-temp">
                    <h2 class="card-title">Suhu Area</h2>
                    <div class="card-temp-content">
                        <div class="temp-icon-wrapper">
                            <svg class="temp-icon" viewBox="0 0 40 80" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="13" y="4" width="14" height="50" rx="7" fill="#E3F0FF" stroke="#2196F3" stroke-width="2"/>
                                <circle cx="20" cy="62" r="14" fill="#E3F0FF" stroke="#2196F3" stroke-width="2"/>
                                <circle cx="20" cy="62" r="8" fill="#DC2626"/>
                                <rect x="17" y="30" width="6" height="26" rx="3" fill="#DC2626"/>
                                <!-- Tick marks -->
                                <line x1="28" y1="15" x2="33" y2="15" stroke="#2196F3" stroke-width="1.5"/>
                                <line x1="28" y1="22" x2="33" y2="22" stroke="#2196F3" stroke-width="1.5"/>
                                <line x1="28" y1="29" x2="33" y2="29" stroke="#2196F3" stroke-width="1.5"/>
                                <line x1="28" y1="36" x2="33" y2="36" stroke="#2196F3" stroke-width="1.5"/>
                                <line x1="28" y1="43" x2="33" y2="43" stroke="#2196F3" stroke-width="1.5"/>
                            </svg>
                        </div>
                        <span class="temp-value" id="tempValue">28.5°</span>
                    </div>
                </div>
            </div>

            <!-- System Status Card -->
            <div class="card card-system" id="cardSystem">
                <h2 class="card-title">Status Sistem</h2>
                <div class="system-indicators">
                    <!-- Valve -->
                    <div class="system-item" id="valveItem">
                        <div class="system-icon-wrapper valve-icon-wrap">
                            <svg class="system-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M24 4L6 12V24C6 36 14 44 24 46C34 44 42 36 42 24V12L24 4Z" fill="#0B8A1E" fill-opacity="0.15" stroke="#0B8A1E" stroke-width="2"/>
                                <path d="M16 24L22 30L32 20" stroke="#0B8A1E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <span class="system-label">VALVE</span>
                        <span class="system-value" id="valveStatus">TERBUKA</span>
                    </div>

                    <!-- Alarm -->
                    <div class="system-item" id="alarmItem">
                        <div class="system-icon-wrapper alarm-icon-wrap">
                            <svg class="system-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M24 6C18 6 12 10 12 18V28L8 34H40L36 28V18C36 10 30 6 24 6Z" fill="#DC2626" fill-opacity="0.15" stroke="#DC2626" stroke-width="2"/>
                                <circle cx="24" cy="40" r="4" fill="#DC2626" fill-opacity="0.3" stroke="#DC2626" stroke-width="1.5"/>
                                <!-- Sound waves -->
                                <path d="M6 20C4 22 4 26 6 28" stroke="#DC2626" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
                                <path d="M42 20C44 22 44 26 42 28" stroke="#DC2626" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
                            </svg>
                        </div>
                        <span class="system-label">ALARM</span>
                        <span class="system-value alarm-off" id="alarmStatus">NONAKTIF</span>
                    </div>

                    <!-- WiFi -->
                    <div class="system-item" id="wifiItem">
                        <div class="system-icon-wrapper wifi-icon-wrap">
                            <svg class="system-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6 18C12 12 18 8 24 8C30 8 36 12 42 18" stroke="#2196F3" stroke-width="3" stroke-linecap="round"/>
                                <path d="M12 24C16 20 20 17 24 17C28 17 32 20 36 24" stroke="#2196F3" stroke-width="3" stroke-linecap="round"/>
                                <path d="M18 30C20 28 22 26 24 26C26 26 28 28 30 30" stroke="#2196F3" stroke-width="3" stroke-linecap="round"/>
                                <circle cx="24" cy="36" r="3" fill="#2196F3"/>
                            </svg>
                        </div>
                        <span class="system-label">WIFI</span>
                        <span class="system-value wifi-connected" id="wifiStatus">TERHUBUNG</span>
                    </div>
                </div>
            </div>

            <!-- History Section -->
            <div class="card card-history">
                <div class="history-header">
                    <h2 class="card-title">Riwayat Terbaru</h2>
                    <button class="btn-view-all" id="btnViewAll">Lihat Semua</button>
                </div>
                <div class="history-table-wrapper">
                    <table class="history-table" id="historyTable">
                        <thead>
                            <tr>
                                <th>Tanggal</th>
                                <th>Jam</th>
                                <th>Status</th>
                                <th>Suhu</th>
                            </tr>
                        </thead>
                        <tbody id="historyBody">
                            <!-- Rows populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="dashboard-footer">
            <p>&copy; 2026 SP3S - Smart Portable Stove Safety System</p>
        </footer>
    </div>

    <!-- Modal for History -->
    <div id="historyModal" class="modal-overlay" style="display:none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Riwayat Lengkap</h2>
                <button class="modal-close" id="modalClose">&times;</button>
            </div>
            <div class="modal-body">
                <table class="history-table modal-table">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>Jam</th>
                            <th>Status</th>
                            <th>Suhu</th>
                        </tr>
                    </thead>
                    <tbody id="modalHistoryBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
