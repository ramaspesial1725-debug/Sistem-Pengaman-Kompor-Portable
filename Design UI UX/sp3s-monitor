    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.input-wrapper {
    width: 100%;
    position: relative;
}

.input-wrapper input {
    width: 100%;
    padding: 14px 20px;
    border: 2px solid var(--gray-300);
    border-radius: var(--radius-full);
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    color: var(--gray-800);
    background: var(--white);
    outline: none;
    transition: var(--transition);
    text-align: center;
}

.input-wrapper input::placeholder {
